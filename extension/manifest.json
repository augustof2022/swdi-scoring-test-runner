{
  "manifest_version": 3,
  "name": "SWDI Scoring Test Capture",
  "short_name": "SWDI Test Capture",
  "description": "Read-only: captures the SWDI score, roster and answers from a 4Ps Forward Assessment Review and sends them to the SWDI Scoring Test Runner. Never edits or submits.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://4ps-dp-preprod.dswd.gov.ph/*",
    "https://4ps-dp-preprod-loadtest.dswd.gov.ph/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "SWDI Test Capture", "default_popup": "popup.html" },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
}
